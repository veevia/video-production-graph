{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "vpg/artifacts/voice-direction",
 "title": "voice-direction",
 "type": "object",
 "properties": {
  "age": {
   "type": "string",
   "minLength": 1,
   "description": "Project-selected voice profile or age category; must match production.voice_age when configured."
  },
  "delivery": {
   "type": "string",
   "minLength": 10
  },
  "engine": {
   "type": "string"
  },
  "voice": {
   "type": "string"
  },
  "pronunciations": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "term": {
      "type": "string"
     },
     "say": {
      "type": "string"
     }
    },
    "required": [
     "term",
     "say"
    ],
    "additionalProperties": true
   }
  },
  "human_listening": {
   "enum": [
    "pending",
    "approved",
    "rejected"
   ]
  },
  "audio_spec": {}
 },
 "required": [
  "age",
  "delivery",
  "engine",
  "human_listening"
 ],
 "additionalProperties": true
}
