{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "vpg/artifacts/review",
 "title": "review",
 "type": "object",
 "properties": {
  "reviewer": {
   "type": "string"
  },
  "scores": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "dimension": {
      "type": "string"
     },
     "score": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
     },
     "evidence": {
      "type": "string",
      "minLength": 3
     }
    },
    "required": [
     "dimension",
     "score",
     "evidence"
    ],
    "additionalProperties": true
   }
  },
  "defects": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "dimension": {
      "type": "string"
     },
     "severity": {
      "enum": [
       "P1",
       "P2",
       "P3",
       "nit"
      ]
     },
     "description": {
      "type": "string",
      "minLength": 5
     },
     "evidence": {
      "type": "string"
     },
     "traced_node": {
      "type": "string"
     },
     "smallest_fix": {
      "type": "string"
     }
    },
    "required": [
     "dimension",
     "severity",
     "description",
     "traced_node"
    ],
    "additionalProperties": true
   }
  },
  "lenses": {
   "type": "object"
  }
 },
 "required": [
  "reviewer",
  "scores"
 ],
 "additionalProperties": true
}
