{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "vpg/production-history",
 "title": "production history (case study)",
 "type": "object",
 "required": [
  "schema",
  "project",
  "sources_read",
  "iterations",
  "tools",
  "recurring_issues",
  "failed_approaches",
  "quality_thresholds_used",
  "unresolved",
  "unrecoverable"
 ],
 "properties": {
  "schema": {
   "type": "string"
  },
  "project": {
   "type": "object",
   "properties": {
    "root": {
     "type": "string",
     "description": "Production root; iteration output paths are relative to it."
    }
   }
  },
  "sources_read": {
   "type": "array",
   "items": {
    "type": "object"
   },
   "minItems": 1
  },
  "iterations": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "round": {
      "type": "string"
     },
     "version": {
      "type": "string"
     },
     "objective": {
      "type": "string"
     },
     "decisions": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "text": {
         "type": "string"
        },
        "evidence": {
         "enum": [
          "recovered",
          "inferred"
         ]
        },
        "source": {
         "type": "string"
        },
        "scope": {
         "const": "round",
         "description": "A round-level decision in force for every version of the round."
        }
       },
       "required": [
        "text",
        "evidence",
        "source"
       ],
       "additionalProperties": true
      }
     },
     "outputs": {
      "type": "array",
      "items": {
       "type": "object"
      }
     },
     "critique": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "by": {
         "type": "string",
         "minLength": 1,
         "description": "Who made the critique; 'none recorded (reconstruction note)' when a version has no critique."
        },
        "text": {
         "type": "string"
        },
        "source": {
         "type": "string"
        }
       },
       "required": [
        "text",
        "source"
       ],
       "additionalProperties": true
      }
     },
     "feedback": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "by": {
         "type": "string"
        },
        "text": {
         "type": "string"
        },
        "source": {
         "type": "string"
        }
       },
       "required": [
        "text",
        "source"
       ],
       "additionalProperties": true
      }
     },
     "corrections": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "text": {
         "type": "string"
        },
        "source": {
         "type": "string"
        }
       },
       "required": [
        "text",
        "source"
       ],
       "additionalProperties": true
      }
     },
     "outcome": {
      "type": "object",
      "properties": {
       "text": {
        "type": "string"
       },
       "source": {
        "type": "string"
       }
      },
      "required": [
       "text",
       "source"
      ],
      "additionalProperties": true
     },
     "lessons": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "text": {
         "type": "string"
        },
        "class": {
         "enum": [
          "recovered",
          "inferred"
         ]
        },
        "source": {
         "type": "string",
         "minLength": 1,
         "description": "Required for recovered lessons: the line that states it."
        },
        "from": {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+\\.(decisions|critique|feedback|corrections|outcome)(\\[[0-9]+\\])?$"
         },
         "description": "Required for inferred lessons: the items of this history it is drawn from."
        }
       },
       "required": [
        "text",
        "class"
       ],
       "additionalProperties": true,
       "allOf": [
        {
         "if": {
          "properties": {
           "class": {
            "const": "recovered"
           }
          }
         },
         "then": {
          "required": [
           "source"
          ]
         }
        },
        {
         "if": {
          "properties": {
           "class": {
            "const": "inferred"
           }
          }
         },
         "then": {
          "required": [
           "from"
          ]
         }
        }
       ]
      },
      "minItems": 1
     }
    },
    "required": [
     "id",
     "round",
     "version",
     "objective",
     "decisions",
     "outputs",
     "critique",
     "feedback",
     "corrections",
     "outcome",
     "lessons"
    ],
    "additionalProperties": true
   },
   "minItems": 1
  },
  "tools": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "recurring_issues": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "failed_approaches": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "quality_thresholds_used": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "unresolved": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "unrecoverable": {
   "type": "array",
   "items": {
    "type": "object"
   },
   "minItems": 1
  },
  "recommendations": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "text": {
      "type": "string"
     },
     "class": {
      "enum": [
       "recommended"
      ]
     },
     "introduced_by": {
      "type": "string"
     }
    },
    "required": [
     "text",
     "class"
    ],
    "additionalProperties": true
   }
  },
  "workspace_root": {
   "type": "string",
   "description": "Absolute workspace path on the machine where the history was recorded; citations are absolute paths under it."
  },
  "archives": {
   "type": "array",
   "description": "Folders whose cited files a later commit removed (a project archive). A cited path missing on disk resolves from the commit before `removed_in`, only if it lies under `path`, exists there as a regular file or folder, is gone at `removed_in`, is untracked at HEAD, and `removed_in` is in the checked-out history, its remote-tracking upstream, or the configured remote's default branch that `kept_in` names (#183).",
   "items": {
    "type": "object",
    "required": ["path", "removed_in"],
    "additionalProperties": false,
    "properties": {
     "path": {"type": "string", "pattern": "^(?!.*\\n)(?!/)(?!.*(^|/)\\.{1,2}(/|$))(?!.*//).+/$", "description": "Folder relative to the git top level of workspace_root, with a trailing slash."},
     "removed_in": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}$", "description": "Full sha of the commit that removed the cited files."},
     "kept_in": {"type": "string", "pattern": "^(?!.*\\n)(?!.*\\.\\.)(?!refs/(?!remotes/))(?:refs/remotes/)?[A-Za-z0-9_][A-Za-z0-9._-]*(?:/[A-Za-z0-9_][A-Za-z0-9._-]*)+$", "description": "The default branch of a configured remote (<remote>/<branch>, exactly the ref its refs/remotes/<remote>/HEAD points to): a published copy of the repository that keeps `removed_in` when the checked-out history does not, e.g. after a copy was published with a fresh history. Any other branch, a local branch or an unconfigured remote vouches for nothing."},
     "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
     "copy": {"type": "string", "description": "Where a local copy of the removed files is kept; informational, never read."},
     "note": {"type": "string"}
    }
   }
  },
  "wei_messages": {
   "type": "array",
   "description": "Index of the requester's messages cited as wei:Mn.",
   "items": {
    "type": "object",
    "required": [
     "id",
     "kind",
     "summary",
     "source",
     "cited_by_rules"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^M[0-9]+$"
     },
     "kind": {
      "enum": [
       "instruction",
       "feedback",
       "handoff",
       "commit",
       "brief"
      ]
     },
     "rounds": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "summary": {
      "type": "string",
      "minLength": 1
     },
     "source": {
      "type": "string",
      "minLength": 1
     },
     "cited_by_rules": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "task_observations": {
   "type": "array",
   "description": "Evidence introduced by building the workflow, cited as task:<id>.",
   "items": {
    "type": "object",
    "required": [
     "id",
     "class",
     "text",
     "source"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "class": {
      "const": "recommended"
     },
     "text": {
      "type": "string",
      "minLength": 1
     },
     "source": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}
