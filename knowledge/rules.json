{
 "schema": "vpg-rules/v1",
 "version": "1.0",
 "updated": "template",
 "note": "Generic built-in policies. Defaults are not evidence of human approval or production calibration.",
 "protected_scopes": [
  "product_truth",
  "objective",
  "brand_constraints",
  "approved_design_principles"
 ],
 "categories": [
  "design_principles",
  "creative_narrative_preferences",
  "craft_quality",
  "legibility_accessibility",
