   "lifecycle": {
    "state": "builtin",
    "history": []
   },
   "evidence": []
  },
  {
   "id": "R-CAP-001",
   "statement": "Captions are speech-locked: never after the first spoken word; mid-sentence lead ≤ 0.20 s; sentence-first lead ≤ 0.45 s into cleared time; never clear > 0.10 s before the last word.",
   "category": "legibility_accessibility",
   "scope": "production_default",
   "check": {
    "type": "tool",
    "fn": "captions:sync",
    "test": "tests/test_tools.py::test_caption_sync_detects_lag_and_early_clear"
