   "scope": "production_default",
   "check": {
    "type": "tool",
    "fn": "legibility:check (density)",
    "test": "tests/test_tools.py::test_density_limit",
    "never": [
     "Show the whole system at once",
     "Animate several groups simultaneously"
    ],
    "always": [
     "Reveal one idea per spoken cue"
    ]
   },
   "threshold": "",
   "rubric_dimensions": [
    "LEG-DENSITY",
    "CRE-ONE-MESSAGE"
   ],
   "default_enforcement": "enforced",
