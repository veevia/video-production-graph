 "rules": [
  {
   "id": "R-PRO-001",
   "statement": "Never stop after one production round: keep the produce→critique→fix loop running until every gate passes or a genuine blocker is reported.",
   "category": "production_defaults",
   "scope": "production_default",
   "check": {
    "type": "tool",
    "fn": "engine:review_gate",
    "test": "tests/test_engine.py::test_targeted_rework_cycle"
   },
   "threshold": "",
   "rubric_dimensions": [],
   "default_enforcement": "enforced",
   "lifecycle": {
    "state": "builtin",
    "history": []
   },
   "evidence": []
  },
  {
   "id": "R-PRO-002",
   "statement": "Machine QA and critic READY are never human approval: human listening, taste and release are separate named decisions, and dry-run approvals are labelled not human.",
   "category": "recurring_failure_patterns",
   "scope": "production_default",
   "check": {
    "type": "tool",
    "fn": "engine:decide",
    "test": "tests/test_engine.py::test_human_gate_requires_named_human"
   },
   "threshold": "",
   "rubric_dimensions": [],
   "default_enforcement": "enforced",
   "lifecycle": {
    "state": "builtin",
    "history": []
   },
   "evidence": []
  },
  {
   "id": "R-PRO-003",
   "statement": "Freeze and hash the source evidence before rendering; if sources drift, re-render from the frozen sources instead of weakening the test.",
   "category": "effective_corrective_actions",
   "scope": "production_default",
   "check": {
    "type": "tool",
    "fn": "engine:_integrity_problems",
    "test": "tests/test_engine.py::test_frozen_inputs_are_immutable"
   },
   "threshold": "",
   "rubric_dimensions": [],
   "default_enforcement": "advisory",
   "lifecycle": {
    "state": "builtin",
    "history": []
   },
   "evidence": []
  },
  {
   "id": "R-PRO-004",
   "statement": "Prove a change on one 10–15 s clip with real assets before batching it across the film.",
   "category": "production_defaults",
   "scope": "production_default",
   "check": {
    "type": "review",
    "never": [
     "Batch a new look, voice or motion rule across every chapter before a single-clip proof"
    ],
    "always": [
     "Render a 10–15 s actual-asset proof and review it first"
    ]
   },
   "threshold": "",
   "rubric_dimensions": [],
   "default_enforcement": "enforced",
   "lifecycle": {
    "state": "builtin",
    "history": []
   },
   "evidence": []
  },
  {
   "id": "R-PRO-005",
   "statement": "Preserve every rejected version with its failure evidence; replace a strong element only when the new one is demonstrably better.",
   "category": "production_defaults",
   "scope": "production_default",
   "check": {
    "type": "tool",
    "fn": "engine:_commit_outputs (superseded, never deleted)",
    "test": "tests/test_engine.py::test_lineage_and_superseded_artifacts"
   },
   "threshold": "",
   "rubric_dimensions": [],
   "default_enforcement": "enforced",
   "lifecycle": {
    "state": "builtin",
    "history": []
   },
   "evidence": []
  },
  {
   "id": "R-PRO-006",
   "statement": "The runtime cap is a hard constraint: cut words and holds, never evidence the viewer needs, and never speed up the voice.",
   "category": "production_defaults",
   "scope": "production_default",
   "check": {
    "type": "tool",
    "fn": "pacing:estimate_script",
    "test": "tests/test_tools.py::test_runtime_estimate_blocks_over_cap"
   },
   "threshold": "brief.runtime_max_s",
   "rubric_dimensions": [
    "PAC-RUNTIME",
    "TEC-DURATION"
   ],
   "default_enforcement": "enforced",
   "lifecycle": {
    "state": "builtin",
    "history": []
   },
   "evidence": []
  },
  {
   "id": "R-PRO-007",
   "statement": "Every version is reviewed on its own rendered evidence by an independent critic through the project's review lenses; an earlier READY never survives new rejection.",
   "category": "recurring_failure_patterns",
   "scope": "production_default",
   "check": {
    "type": "tool",
    "fn": "evaluation:gate (reviews must be current-version)",
    "test": "tests/test_engine.py::test_gate_blocks_without_current_reviews"
   },
   "threshold": "",
   "rubric_dimensions": [
    "CRE-LENSES"
   ],
   "default_enforcement": "enforced",
   "lifecycle": {
    "state": "builtin",
    "history": []
   },
   "evidence": []
  },
  {
   "id": "R-PRO-008",
   "statement": "Scope each rework to the exact critic findings and re-run only what they trace to; never restart broadly.",
   "category": "effective_corrective_actions",
   "scope": "production_default",
   "check": {
    "type": "tool",
    "fn": "regen:plan",
    "test": "tests/test_engine.py::test_targeted_rework_cycle"
   },
   "threshold": "",
   "rubric_dimensions": [],
   "default_enforcement": "enforced",
   "lifecycle": {
    "state": "builtin",
    "history": []
   },
   "evidence": []
  },
  {
   "id": "R-VOI-001",
   "statement": "Narration matches the project's approved voice profile and delivery; listening quality is judged by a named human.",
   "category": "voice_sound_pacing_transitions",
   "scope": "production_default",
   "check": {
    "type": "human",
    "never": [
     "Ship a delivery that contradicts the approved voice direction"
    ],
    "always": [
     "Record the project-selected voice profile and delivery in voice-direction.json",
     "Request the project owner's listening sign-off"
    ],
    "test": "tests/test_tools.py::test_voice_direction_matches_the_project_profile"
   },
   "threshold": "",
   "rubric_dimensions": [
    "VOI-ADULT"
   ],
   "default_enforcement": "enforced",
   "lifecycle": {
    "state": "builtin",
    "history": []
   },
   "evidence": []
  },
  {
   "id": "R-VOI-002",
   "statement": "No stutter, dropped word, clipped ending or seam: every script unit is spoken in order, and mixing never attenuates inside speech by more than a 6 dB breath dip.",
   "category": "voice_sound_pacing_transitions",
   "scope": "production_default",
   "check": {
    "type": "tool",
    "fn": "audio:check_voice",
    "test": "tests/test_tools.py::test_voice_check_catches_dropped_unit"
   },
   "threshold": "max_speech_dip_db 6",
   "rubric_dimensions": [
    "VOI-COMPLETE"
   ],
   "default_enforcement": "enforced",
   "lifecycle": {
    "state": "builtin",
    "history": []
   },
   "evidence": []
  },
  {
   "id": "R-VOI-003",
   "statement": "Pronunciation is verified per product term; if a term is misheard in most takes, rephrase the line instead of shipping the error.",
   "category": "voice_sound_pacing_transitions",
   "scope": "production_default",
   "check": {
    "type": "review",
    "never": [
     "Keep a product term that ASR mishears in most takes"
    ],
    "always": [
     "List product terms and their expected pronunciation in voice-direction.json"
    ]
   },
   "threshold": "",
   "rubric_dimensions": [
    "VOI-PRONUNCIATION"
   ],
   "default_enforcement": "enforced",
   "lifecycle": {
    "state": "builtin",
    "history": []
   },
   "evidence": []
  },
  {
   "id": "R-AUD-001",
   "statement": "Deliver at −16 LUFS integrated (±1) with true peak ≤ −1 dBTP, measured on the encoded master.",
   "category": "voice_sound_pacing_transitions",
   "scope": "production_default",
   "check": {
    "type": "tool",
    "fn": "media:technical_qa",
    "test": "tests/test_tools.py::test_technical_qa_on_real_media"
   },
   "threshold": "-16 LUFS ±1; TP ≤ -1 dBTP",
   "rubric_dimensions": [
    "TEC-LOUDNESS"
   ],
   "default_enforcement": "enforced",
   "lifecycle": {
    "state": "builtin",
    "history": []
   },
   "evidence": []
  },
  {
   "id": "R-AUD-002",
   "statement": "Music supports the voice: look-ahead ducking under speech, no competing phrases, no abrupt cuts; voice over music p10 ≥ 16 LU.",
   "category": "voice_sound_pacing_transitions",
   "scope": "production_default",
   "check": {
    "type": "human",
    "never": [
     "Let music phrases compete with narration",
     "Cut music abruptly at a seam"
    ],
    "always": [
     "Duck under speech",
     "Test several directions before choosing"
    ]
   },
   "threshold": "",
   "rubric_dimensions": [
    "CRE-MUSIC"
   ],
   "default_enforcement": "enforced",
   "lifecycle": {
    "state": "builtin",
    "history": []
   },
   "evidence": []
  },
  {
   "id": "R-AUD-003",
   "statement": "Every silence longer than 1.5 s is a planned pause; unexplained silence is a defect.",
   "category": "voice_sound_pacing_transitions",
   "scope": "production_default",
   "check": {
    "type": "tool",
    "fn": "media:technical_qa",
    "test": "tests/test_tools.py::test_technical_qa_flags_unexplained_silence"
